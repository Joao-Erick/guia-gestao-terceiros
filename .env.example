# Configuração opcional para execução local. Copie para .env se necessário.
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_PATH=data/app.db
MEDIA_DIR=media
DIST_DIR=frontend/dist
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
TRIAL_DAYS=14
MAX_UPLOAD_MB=300
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
SEED_ON_START=true
# DEMO_PASSWORD=defina-uma-senha-apenas-para-testes
